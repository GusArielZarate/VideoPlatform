# ========================================================
# VARIABLES DE ENTORNO PARA EC2 - VIDEOPLATFORM API
# ========================================================

# 1. Base de datos Amazon RDS (PostgreSQL)
# Formato: postgresql://<USUARIO>:<PASSWORD>@<RDS_ENDPOINT>:5432/<NOMBRE_BD>
DATABASE_URL=postgresql://postgres:tu_password_rds@tu-rds-endpoint.us-east-1.rds.amazonaws.com:5432/videoplatform

# 2. Configuración de Amazon S3 (Almacenamiento de Videos y Miniaturas)
# NOTA: En EC2, NO pongas credenciales aquí. Asigna un IAM Role a la instancia EC2.
AWS_REGION=us-east-1
S3_BUCKET_VIDEOS=tu-bucket-videos-s3
S3_BUCKET_THUMBNAILS=tu-bucket-miniaturas-s3
USE_S3=true

# 3. URL base de la API (Dirección IP pública o DNS de tu instancia EC2)
API_BASE_URL=http://tu-ec2-ip-publica:8000
